# ---------------------------------------------------------------------------
# Hybrid RAG for Financial Reports - environment configuration
# Copy this file to `.env` and adjust as needed. Do not commit real secrets.
# ---------------------------------------------------------------------------

# --- Local LLM (Ollama) ---
# The model name is configurable so you can swap the local model later.
LLM_MODEL=llama3.1:8b
LLM_BASE_URL=http://localhost:11434
# Generous timeout: the first request on CPU loads the model into memory
# (cold start) which can take a few minutes for an 8B model.
LLM_TIMEOUT=300
LLM_TEMPERATURE=0.0

# --- Embedding model (local, open-source; no paid API) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Cross-encoder reranker (local, open-source) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking (word-based) ---
CHUNK_SIZE=200
CHUNK_OVERLAP=40

# --- Retrieval ---
# Retrieve wide, rerank narrow: a wide candidate pool lets a precise-but-terse
# table row (which one retriever may rank in the 50s) still reach the
# cross-encoder, which then promotes the truly relevant evidence.
TOP_K_DENSE=60
TOP_K_BM25=60
TOP_K_HYBRID=60
RERANK_TOP_K=4
# Weight on dense vs BM25 in hybrid fusion: alpha*dense + (1-alpha)*bm25
HYBRID_ALPHA=0.5

# --- Query expansion (recall) ---
# Controlled expansion of the dense+BM25 RETRIEVAL query for data-seeking
# questions: a small curated set of concept synonyms (scope 1 / direct / GHG /
# greenhouse gas ...) plus fiscal-year normalization (FY2023 -> 2023) so a
# terse exact-value table row a paraphrase shares no surface with still enters
# the candidate union and reaches the cross-encoder. The reranker and LLM
# always get the ORIGINAL question, so precision/grounding are unchanged. Set
# false to restore original-query-only retrieval.
ENABLE_QUERY_EXPANSION=true

# --- Answerability / hallucination control ---
# Below these thresholds the system refuses instead of hallucinating.
MIN_RERANK_SCORE=-4.0
MIN_HYBRID_SCORE=0.15

# --- Citation verification (lexical overlap thresholds) ---
VERIFY_SUPPORTED_THRESHOLD=0.45
VERIFY_PARTIAL_THRESHOLD=0.2

# --- Multimodal / visual ingestion (OPT-IN, reversible) ---
# Master switch. Default false = original text-only pipeline (identical chunk
# ids). Set true to also index vector tables, scanned pages (OCR) and figures.
ENABLE_VISUAL_INGEST=false
# Sub-features (only apply when ENABLE_VISUAL_INGEST=true):
ENABLE_TABLE_EXTRACTION=true
ENABLE_OCR=true
OCR_LANGUAGE=eng
# Optional absolute path to tesseract.exe if it is not on PATH (Windows).
TESSERACT_CMD=
PAGE_RENDER_DPI=150
# Pages with fewer than this many text chars are treated as scanned and OCR'd.
OCR_MIN_CHARS=20
# Figure/chart selection: min page-area fraction, and min OCR chars to keep.
FIGURE_MIN_AREA_RATIO=0.05
FIGURE_MIN_OCR_CHARS=12

# --- Data locations ---
# DOCUMENTS_DIR is the RAG knowledge base (PDFs are discovered recursively).
DOCUMENTS_DIR=./Structured data-20250319T105519Z-001
# QA_CSV_PATH is used ONLY for evaluation/benchmarking, never for retrieval.
QA_CSV_PATH=./Data_ret.csv

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
