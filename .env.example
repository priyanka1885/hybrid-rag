# ---------------------------------------------------------------------------
# Hybrid RAG for Financial Reports - environment configuration
# Copy this file to `.env` and adjust as needed. Do not commit real secrets.
# ---------------------------------------------------------------------------

# --- LLM (OpenRouter, OpenAI-compatible chat completions) ---
# Generation runs on OpenRouter's hosted API using the free Llama 3.1 8B
# Instruct model. Create a key at https://openrouter.ai/keys and put it in your
# local .env (never commit a real key).
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLM_MODEL=inclusionai/ling-3.0-flash-fin:free
LLM_BASE_URL=https://openrouter.ai/api
# Request timeout in seconds for a single chat-completion call. Hosted models
# respond quickly, but free-tier requests can queue, so keep it generous.
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.0

# --- Embedding model (local, open-source; no paid API) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Cross-encoder reranker (local, open-source) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Memory budgets (serving) ---
# The service is memory-bound: the two fp32 ONNX sessions alone hold ~200 MB
# resident, so a 512 MB instance has little headroom. The knobs below cap peak
# transient memory. None of them change any score: padding is excluded by the
# attention mask, so batching affects only memory and speed.
#
# A transformer's peak allocation is the attention matrix, sized
# batch * heads * seq_len^2 * 4 bytes - note the SQUARE on sequence length. So
# batches are budgeted on batch * seq^2 instead of on batch alone. At 262144 the
# attention tensor stays around 12 MB for these 12-head models; a fixed batch of
# 16 padded to 512 tokens would have been ~192 MB. Lower these if the instance is
# tight, raise them to trade memory for latency.
RERANK_TOKEN_BUDGET=262144
RERANK_BATCH_SIZE=16
EMBED_TOKEN_BUDGET=262144
# Cap on the thread pool that runs the API's sync endpoints (Starlette's default
# is 40). Each in-flight request holds its own candidate pool and response tree,
# so this directly multiplies peak memory. Excess requests queue instead.
MAX_REQUEST_THREADS=2
# glibc keeps freed memory in per-thread arenas rather than returning it to the
# OS, so resident memory otherwise ratchets upward request after request and
# eventually trips the instance limit. Must be set in the environment to take
# effect at process start.
MALLOC_ARENA_MAX=2
OMP_NUM_THREADS=1

# --- Chunking (word-based) ---
CHUNK_SIZE=200
CHUNK_OVERLAP=40

# --- Retrieval ---
# Retrieve wide, rerank narrow: a wide candidate pool lets a precise-but-terse
# table row (which one retriever may rank in the 50s) still reach the
# cross-encoder, which then promotes the truly relevant evidence.
TOP_K_DENSE=60
TOP_K_BM25=60
TOP_K_HYBRID=60
RERANK_TOP_K=4
# Weight on dense vs BM25 in hybrid fusion: alpha*dense + (1-alpha)*bm25
HYBRID_ALPHA=0.5

# --- Query expansion (recall) ---
# Controlled expansion of the dense+BM25 RETRIEVAL query for data-seeking
# questions: a small curated set of concept synonyms (scope 1 / direct / GHG /
# greenhouse gas ...) plus fiscal-year normalization (FY2023 -> 2023) so a
# terse exact-value table row a paraphrase shares no surface with still enters
# the candidate union and reaches the cross-encoder. The reranker and LLM
# always get the ORIGINAL question, so precision/grounding are unchanged. Set
# false to restore original-query-only retrieval.
ENABLE_QUERY_EXPANSION=true

# --- Answerability / hallucination control ---
# Below these thresholds the system refuses instead of hallucinating.
MIN_RERANK_SCORE=-4.0
MIN_HYBRID_SCORE=0.15

# --- Citation verification (lexical overlap thresholds) ---
VERIFY_SUPPORTED_THRESHOLD=0.45
VERIFY_PARTIAL_THRESHOLD=0.2

# --- Multimodal / visual ingestion (OPT-IN, reversible) ---
# Master switch. Default false = original text-only pipeline (identical chunk
# ids). Set true to also index vector tables, scanned pages (OCR) and figures.
ENABLE_VISUAL_INGEST=false
# Sub-features (only apply when ENABLE_VISUAL_INGEST=true):
ENABLE_TABLE_EXTRACTION=true
ENABLE_OCR=true
OCR_LANGUAGE=eng
# Optional absolute path to tesseract.exe if it is not on PATH (Windows).
TESSERACT_CMD=
PAGE_RENDER_DPI=150
# Pages with fewer than this many text chars are treated as scanned and OCR'd.
OCR_MIN_CHARS=20
# Figure/chart selection: min page-area fraction, and min OCR chars to keep.
FIGURE_MIN_AREA_RATIO=0.05
FIGURE_MIN_OCR_CHARS=12

# --- Data locations ---
# DOCUMENTS_DIR is the RAG knowledge base (PDFs are discovered recursively).
DOCUMENTS_DIR=./Structured data-20250319T105519Z-001
# QA_CSV_PATH is used ONLY for evaluation/benchmarking, never for retrieval.
QA_CSV_PATH=./Data_ret.csv

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
